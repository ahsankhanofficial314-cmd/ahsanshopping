{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/auth/signup",
      "dest": "api/auth/signup.js"
    },
    {
      "src": "/api/auth/login",
      "dest": "api/auth/login.js"
    },
    {
      "src": "/api/products",
      "dest": "api/products.js"
    },
    {
      "src": "/api/products/(?<id>[^/]*)",
      "dest": "api/products/[id].js?id=$id"
    },
    {
      "src": "/api/users",
      "dest": "api/users.js"
    },
    {
      "src": "/api/signals",
      "dest": "api/signals.js"
    },
    {
      "src": "/api/checkout",
      "dest": "api/checkout.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
